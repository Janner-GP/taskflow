# ===========================================================================
# TaskFlow — plantilla de variables de entorno
#
# Copia este archivo a `.env` y rellena los valores.  `.env` está en .gitignore
# y CI lo verifica con gitleaks: NUNCA se commitea un valor real.
#
# En producción estas variables NO vienen de un archivo: el CD las pasa desde
# GitHub Secrets al daemon de Docker remoto, así que nunca se escriben en disco
# en el servidor.  Ver README → "Despliegue".
# ===========================================================================

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=cambiame_en_local_y_usa_un_secreto_en_prod

# El backend habla con Postgres por el nombre de servicio de compose ("postgres").
# Para correr el backend nativo contra el Postgres dockerizado usa localhost:5432.
DATABASE_URL=postgresql://taskflow:cambiame_en_local_y_usa_un_secreto_en_prod@postgres:5432/taskflow?schema=public

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Swagger: siempre activo en local. En producción se deja en false y solo se
# enciende puntualmente si hay que demostrar la documentación.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# JWT y cookies — genera cada uno con:  openssl rand -base64 48
# Los tres deben ser DISTINTOS entre sí y distintos por entorno.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=genera_uno_con_openssl_rand_base64_48
JWT_REFRESH_SECRET=genera_OTRO_distinto_con_openssl_rand_base64_48
COOKIE_SECRET=genera_un_TERCERO_distinto_con_openssl_rand_base64_48

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Coste de bcrypt. 12 es un buen equilibrio; subirlo encarece el login.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# CORS — lista separada por comas, sin espacios, nunca "*" porque enviamos
# credenciales. En el stack dockerizado la web es same-origin y esto casi no
# se usa; importa en el loop de desarrollo: 4200 es `ng serve` (web) y 4201 es
# `ionic serve` (mobile en navegador).
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200,http://localhost:4201
APP_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Rate limiting en /auth/* (protección contra fuerza bruta)
# ---------------------------------------------------------------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=10

# ---------------------------------------------------------------------------
# Red y proxy — SOLO producción
# ---------------------------------------------------------------------------
# Interfaz a la que se liga el puerto publicado.
#
# ¡ESTA ES LA VARIABLE MÁS SENSIBLE DEL DESPLIEGUE!
#
# El valor por defecto es 127.0.0.1 a propósito: si llega vacía o mal, el stack
# queda inalcanzable (falla CERRADO) en lugar de expuesto a internet.
#
# En producción va la IP PRIVADA de la VPS de aplicaciones, p. ej. 10.0.0.5,
# para que solo la VPS del proxy pueda alcanzarla y la interfaz pública quede
# sin nada escuchando.
#
# NUNCA pongas 0.0.0.0: los puertos publicados por Docker se insertan como
# reglas DNAT en iptables que se evalúan ANTES que ufw, así que un 0.0.0.0
# queda abierto a internet aunque el firewall diga lo contrario.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080

# IP privada de la VPS del proxy. Es la ÚNICA fuente en la que confiamos para
# X-Forwarded-For / X-Forwarded-Proto. Sin esto, cualquiera que alcance la app
# directamente podría falsificar su IP y saltarse el rate limiting.
TRUSTED_PROXY_IP=10.0.0.4

# ---------------------------------------------------------------------------
# RDS — variables para el script de provisioning (aws/setup.sh)
# setup.sh busca la instancia por RDS_INSTANCE_ID. Si no existe la crea en
# subredes privadas de la VPC taskflow. Si ya está en esa VPC actualiza su SG.
# ---------------------------------------------------------------------------
RDS_INSTANCE_ID=taskflow-postgres
RDS_USERNAME=postgres
RDS_PASSWORD=cambiame_por_una_contrasena_segura
RDS_DB_NAME=postgres

# ---------------------------------------------------------------------------
# AWS S3 — almacenamiento de imágenes adjuntas a tareas
# Las imágenes se guardan con hash SHA-256 (deduplicación automática).
# Genera el par de claves con mínimos privilegios: solo s3:PutObject,
# s3:GetObject, s3:HeadObject y s3:DeleteObject sobre el bucket.
# ---------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_BUCKET_NAME=taskflow-attachments-tu-cuenta

# ---------------------------------------------------------------------------
# Imágenes de contenedor — SOLO producción
# En prod se usa un tag inmutable (sha-<commit>), nunca "latest".
# ---------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/tu-usuario/taskflow
IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# Frontend web (web/src/environments) — se inyecta en build time.
# Aquí NO va ningún secreto: todo lo que llega al navegador es público.
# ---------------------------------------------------------------------------
WEB_API_URL=/api

# ---------------------------------------------------------------------------
# Frontend mobile — el emulador Android no ve "localhost" del host:
# 10.0.2.2 es el alias del host desde el emulador.
# ---------------------------------------------------------------------------
MOBILE_API_URL=http://10.0.2.2:3000/api
